  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Auto-set timestamps for testing",
          "const now = new Date();",
          "const futureDate = new Date(now.getTime() + 7 * 24 * 60 * 60 * 1000);",
          "pm.environment.set('current_timestamp', now.toISOString());",
          "pm.environment.set('future_date', futureDate.toISOString());"
        ]
      }
    }
