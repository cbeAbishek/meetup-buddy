  "item": [
    {
      "name": "🏠 Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}",
          "host": ["{{base_url}}"]
        },
        "description": "Test if the server is running"
      }
    },
    {
      "name": "👤 Profile Management",
      "item": [
        {
          "name": "Get Profile by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/profiles?profileId={{test_user_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "profiles"],
              "query": [{"key": "profileId", "value": "{{test_user_id}}"}]
            }
          }
        },
        {
          "name": "Create Profile",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"john.doe@example.com\",\n  \"full_name\": \"John Doe\",\n  \"avatar_url\": \"https://example.com/avatar.jpg\",\n  \"timezone\": \"America/New_York\",\n  \"preferences\": {\n    \"theme\": \"dark\",\n    \"notifications\": true\n  }\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/profiles",
              "host": ["{{base_url}}"],
              "path": ["api", "profiles"]
            },
            "description": "Create a new user profile. Required: email, full_name. Optional: avatar_url, timezone, preferences"
          }
        },
        {
          "name": "Create Profile (Minimal - No Avatar)",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"jane.smith@example.com\",\n  \"full_name\": \"Jane Smith\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/profiles",
              "host": ["{{base_url}}"],
              "path": ["api", "profiles"]
            },
            "description": "Create profile with only required fields - avatar_url is optional"
          }
        }
      ]
    },
